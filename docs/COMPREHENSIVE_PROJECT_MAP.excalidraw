      "versionNonce": 1398,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "RF = 1 + (k-1) x sum(dilations)\n= 1 + 2 x (1+2+4+8) = 31\nCovers full 20-step input\nwith margin. 31 seconds of context.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RF = 1 + (k-1) x sum(dilations)\n= 1 + 2 x (1+2+4+8) = 31\nCovers full 20-step input\nwith margin. 31 seconds of context.",
      "autoResize": true,
      "lineHeight": 1.25
    },

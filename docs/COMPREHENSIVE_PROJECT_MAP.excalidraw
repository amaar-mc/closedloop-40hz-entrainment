    {
      "id": "48e4dfffa65948fba367",
      "type": "text",
      "x": 12,
      "y": 4200.0,
      "width": 928.1999999999999,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,

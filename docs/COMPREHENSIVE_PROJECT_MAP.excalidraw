      "link": null,
      "locked": false,
      "text": "Why Theta-Gamma Coupling?",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why Theta-Gamma Coupling?",

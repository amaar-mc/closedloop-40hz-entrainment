      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "BatchNorm averages across batch;\nmixes patients. GroupNorm normalizes\neach sample independently.\nPreserves individual patient traits.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BatchNorm averages across batch;\nmixes patients. GroupNorm normalizes\neach sample independently.\nPreserves individual patient traits.",

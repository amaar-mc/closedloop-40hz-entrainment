      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "What is Phase-Amplitude Coupling (PAC)?",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is Phase-Amplitude Coupling (PAC)?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "a65289de7b0e49cd9c20",
      "type": "text",
      "x": 12,
      "y": 2300.0,
      "width": 411.59999999999997,
      "height": 105.0,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1151,
      "version": 1,
      "versionNonce": 1152,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "How strongly the AMPLITUDE of fast oscillations\n(gamma 38-42 Hz) is modulated by the PHASE of\nslow oscillations (theta 4-8 Hz)\n\nHigh PAC = Brain is entrained = Therapy working\nLow PAC = Lost synchronization = Need stimulation",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How strongly the AMPLITUDE of fast oscillations\n(gamma 38-42 Hz) is modulated by the PHASE of\nslow oscillations (theta 4-8 Hz)\n\nHigh PAC = Brain is entrained = Therapy working\nLow PAC = Lost synchronization = Need stimulation",
      "autoResize": true,
      "lineHeight": 1.25
    },

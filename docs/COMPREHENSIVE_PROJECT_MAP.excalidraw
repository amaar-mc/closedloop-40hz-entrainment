      "boundElements": [],
      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "Standard: pads both sides = leaks\nCausal: pads LEFT only = no future\nF.pad(x, (left_pad, 0))\nEssential for real-time deployment",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Standard: pads both sides = leaks\nCausal: pads LEFT only = no future\nF.pad(x, (left_pad, 0))\nEssential for real-time deployment",
      "autoResize": true,
      "lineHeight": 1.25
    },

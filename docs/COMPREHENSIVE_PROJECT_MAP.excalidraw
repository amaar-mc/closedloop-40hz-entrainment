      "versionNonce": 1444,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "Uses rolling z-score of PAC:\n\nz < -0.5  = PAC below baseline\n            = weak coupling = STIMULATE\n\nz > +0.5  = PAC above baseline\n            = strong coupling = REST\n\n-0.5 <= z <= +0.5  = normal range",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uses rolling z-score of PAC:\n\nz < -0.5  = PAC below baseline\n            = weak coupling = STIMULATE\n\nz > +0.5  = PAC above baseline\n            = strong coupling = REST\n\n-0.5 <= z <= +0.5  = normal range",
      "autoResize": true,
      "lineHeight": 1.25
    },

      "roundness": null,
      "seed": 1205,
      "version": 1,
      "versionNonce": 1206,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "MI = KL / log(n_bins)\nRange: 0 to 1\nTypical: 6e-6 to 7e-4\nMean: ~4.4e-5",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MI = KL / log(n_bins)\nRange: 0 to 1\nTypical: 6e-6 to 7e-4\nMean: ~4.4e-5",
      "autoResize": true,
      "lineHeight": 1.25
    },

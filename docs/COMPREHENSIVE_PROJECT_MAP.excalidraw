      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "Step 5: KL Divergence",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 5: KL Divergence",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1889109d46f844cf86a3",
      "type": "text",
      "x": 322,
      "y": 2747.5,
      "width": 216.0,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1197,
      "version": 1,
      "versionNonce": 1198,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "KL = sum(P_i * log(P_i * N))\nMeasures distance from uniform\nUniform = no coupling = KL=0",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "KL = sum(P_i * log(P_i * N))\nMeasures distance from uniform\nUniform = no coupling = KL=0",
      "autoResize": true,
      "lineHeight": 1.25
    },

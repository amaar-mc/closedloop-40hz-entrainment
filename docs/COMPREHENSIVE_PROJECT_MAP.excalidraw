      "link": null,
      "locked": false,
      "text": "Model cannot see future data.\nLeft-only padding ensures no leakage.\nEssential for real-time systems.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Model cannot see future data.\nLeft-only padding ensures no leakage.\nEssential for real-time systems.",

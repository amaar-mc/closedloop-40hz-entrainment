    },
    {
      "id": "0b58eb6531c44c5191aa",
      "type": "text",
      "x": 12,
      "y": 3980.0,
      "width": 369.59999999999997,
      "height": 105.0,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1281,
      "version": 1,
      "versionNonce": 1282,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "Models from 135 to 2,000,000 parameters\nALL converge to R2 = 0.287 or worse.\nLarger models = MORE overfitting.\n\nThis is a DATA CEILING, not a model problem.\nSNR = -4.73 dB (signal weaker than noise).",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Models from 135 to 2,000,000 parameters\nALL converge to R2 = 0.287 or worse.\nLarger models = MORE overfitting.\n\nThis is a DATA CEILING, not a model problem.\nSNR = -4.73 dB (signal weaker than noise).",
      "autoResize": true,
      "lineHeight": 1.25
    },

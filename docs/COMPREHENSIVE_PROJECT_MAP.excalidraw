      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "Model memorizes training data,\nfails on new data. More params\nwith little data = overfitting.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Model memorizes training data,\nfails on new data. More params\nwith little data = overfitting.",

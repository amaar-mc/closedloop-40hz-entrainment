      "locked": false,
      "text": "Why 18 Phase Bins?",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why 18 Phase Bins?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04b51b145bd345178624",
      "type": "text",
      "x": 692,
      "y": 2987.5,
      "width": 216.0,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1223,
      "version": 1,
      "versionNonce": 1224,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "18 bins x 20 degrees = 360 deg\nStandard in PAC literature.\nEnough resolution without\ntoo few samples per bin.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "18 bins x 20 degrees = 360 deg\nStandard in PAC literature.\nEnough resolution without\ntoo few samples per bin.",
      "autoResize": true,
      "lineHeight": 1.25
    },

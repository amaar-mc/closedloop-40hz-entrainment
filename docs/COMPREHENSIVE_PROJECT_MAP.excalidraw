      "updated": 1709000000000,
      "link": null,
      "locked": false,
      "text": "Standard: 12,288 params/block\nDepthwise+Pointwise: 4,288/block\n= 3x fewer parameters\n= less overfitting on 11K samples",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Standard: 12,288 params/block\nDepthwise+Pointwise: 4,288/block\n= 3x fewer parameters\n= less overfitting on 11K samples",
